{
  "name": "@kanakawai-maui/agent-manager",
  "version": "1.0.0",
  "description": "CLI tool and web dashboard for spawning and managing parallel agent worker processes in a tree structure",
  "keywords": [
    "agent",
    "worker",
    "process-manager",
    "cli",
    "dashboard",
    "parallel",
    "tree",
    "llm",
    "ai-agents"
  ],
  "homepage": "https://kanakawai-maui.github.io/agent-manager/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanakawai-maui/agent-manager.git"
  },
  "bugs": {
    "url": "https://github.com/kanakawai-maui/agent-manager/issues"
  },
  "license": "MIT",
  "author": "kanakawai-maui",
  "main": "dist/cli.js",
  "bin": {
    "agent-manager": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE",
    "provider-configs.example.json"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "web": "node dist/web-server.js",
    "web:dev": "ts-node src/web-server.ts",
    "clean": "rm -rf dist",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
